# === إعدادات واتساب ===
# معرف الجروب المستهدف (يظهر في السجل عند أول اتصال)
TARGET_GROUP_ID=120363XXXXXXXXX@g.us

# === إعدادات Google Sheets ===
# معرف الجدول (من رابط الجدول)
# مثال: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# مسار ملف بيانات الاعتماد (Service Account JSON)
CREDENTIALS_PATH=./credentials.json

# === إعدادات السجل ===
# مستويات: error, warn, info, debug
LOG_LEVEL=info
